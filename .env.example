# Copie ce fichier en ".env" et remplis tes vraies valeurs.
# ".env" est dans .gitignore : ne JAMAIS committer de vrais identifiants.
#
# Procédure de création : voir README.md, section "Module OVH VPS".

OVH_APP_KEY=
OVH_APP_SECRET=
OVH_CONSUMER_KEY=
OVH_SERVICE_NAME=
# ovh-eu (défaut) / ovh-us / ovh-ca / kimsufi-eu / kimsufi-ca / soyoustart-eu / soyoustart-ca
OVH_ENDPOINT=ovh-eu
